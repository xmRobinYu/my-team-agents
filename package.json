{
  "name": "my-team-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant company-grade agent team platform. Core agent loop: Pi. Skeleton modeled on teamagentx (trigger -> queue -> executor -> structured handoff).",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test",
    "verify:cli": "node packages/cost-report/dist/cli.js --help"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
