{
  "name": "@my-team-agents/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@assistant-ui/react-pi": "^0.0.32",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@fastify/static": "8.3.0",
    "@my-team-agents/orchestrator": "workspace:*",
    "@my-team-agents/runtime-cli": "workspace:*",
    "@my-team-agents/runtime-core": "workspace:*",
    "@my-team-agents/runtime-pi": "workspace:*",
    "fastify": "5.6.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
